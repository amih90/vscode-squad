{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder:vscode-squad}"
      ],
      "outFiles": [
        "${workspaceFolder:vscode-squad}/out/**/*.js"
      ],
      "preLaunchTask": "npm: compile - vscode-squad"
    }
  ]
}
